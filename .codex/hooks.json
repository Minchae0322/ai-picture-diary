{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/minchae/sources/ai-picture-diary/.codex/hooks/after-edit.sh'",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/minchae/sources/ai-picture-diary/.codex/hooks/before-stop.sh'",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
