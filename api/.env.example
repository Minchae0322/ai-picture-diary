# 로컬은 application-local.yml 기본값으로 뜬다. 아래는 dev/prod 주입용 목록.
# 시크릿은 값으로 커밋하지 않는다 (config-and-secrets 1장)

DB_URL=jdbc:postgresql://localhost:5432/jellydiary   # DB 접속 URL (환경 의존값)
DB_USERNAME=jelly                                    # DB 사용자 (환경 의존값)
DB_PASSWORD=                                         # DB 비밀번호 (시크릿)

AI_PROVIDER=mock                                     # mock | openai (공개 설정)
AI_MOCK_DELAY=1500ms                                 # 대역 응답 지연 (공개 설정)
TRACING_SAMPLING=0.2                                 # 트레이스 샘플링 비율 (공개 설정)
